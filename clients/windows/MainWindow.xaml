<ui:FluentWindow x:Class="StateOfMe.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="State of Me" Width="920" Height="740" MinWidth="720" MinHeight="580" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" ExtendsContentIntoTitleBar="True">
<DockPanel><ui:TitleBar Title="State of Me" DockPanel.Dock="Top"/><Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Content="暂停分享" Click="Pause" Margin="8,0"/><ui:Button Content="保存并开始分享" Appearance="Primary" Click="Save"/></StackPanel></Grid></Border>
<Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="此刻，由你决定分享什么" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="本机采集、上传和对外展示，分别掌握。" Margin="0,8,0,0" Opacity="0.65"/></StackPanel>
<TabControl Grid.Row="1">
<TabItem Header="概览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><ui:Card Padding="20"><StackPanel><TextBlock Text="分享状态" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="Summary" FontSize="16" Margin="0,12"/><TextBlock x:Name="Counters" Opacity="0.65"/></StackPanel></ui:Card><TextBlock Text="临时状态" FontSize="18" Margin="0,24,0,8"/><ui:TextBox x:Name="Manual" PlaceholderText="例如：专注写代码，稍后回复" MaxLength="120"/><TextBlock Text="保存后保留 1 小时，留空即清除。隐身与暂停优先。" Margin="0,8" Opacity="0.65"/><WrapPanel><ui:Button Content="隐身 15 分钟" Click="HideBriefly" Margin="0,8,12,8"/><ui:Button Content="读取受众预览" Click="AudiencePreview" Margin="0,8"/></WrapPanel><TextBlock Text="受众预览需要对应的只读令牌；写入令牌不能读取私有状态。" Opacity="0.65"/><ui:PasswordBox x:Name="ReadToken" Margin="0,8"/><Expander Header="本地上传预览与诊断" Margin="0,16"><StackPanel><TextBlock x:Name="Health" Margin="0,8"/><TextBox x:Name="Preview" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" MaxHeight="230"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
<TabItem Header="分享"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="前台应用" FontSize="20"/><TextBlock Text="选中应用按所选规则处理；右侧可填写展示别名。列表来自运行中的窗口，已选应用会保留。" Margin="0,8"/><ComboBox x:Name="FilterMode" SelectedIndex="1"><ComboBoxItem Content="关闭应用分享"/><ComboBoxItem Content="只分享选中的应用"/><ComboBoxItem Content="隐藏选中的应用"/></ComboBox><DockPanel Margin="0,12"><ui:Button DockPanel.Dock="Right" Content="刷新应用" Click="RefreshApps" Margin="12,0,0,0"/><ui:TextBox x:Name="Search" PlaceholderText="搜索应用名称" TextChanged="SearchChanged"/></DockPanel><ListBox x:Name="AppList" Height="220"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBox DockPanel.Dock="Right" Text="{Binding Alias,UpdateSourceTrigger=PropertyChanged}" Width="160" Height="32" MaxLength="120" ToolTip="可选展示别名" Margin="12,0"/><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0"/><CheckBox Margin="0" IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Label}" ToolTip="{Binding Id}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="其他信息" FontSize="20" Margin="0,20,0,6"/><WrapPanel><StackPanel Width="260"><CheckBox x:Name="SharePresence" Content="活跃、空闲与锁屏"/><CheckBox x:Name="ShareDevice" Content="电量与电源状态"/><CheckBox x:Name="ShareNetwork" Content="连接类型与联网状态"/><CheckBox x:Name="ShareAudio" Content="音量与静音"/></StackPanel><StackPanel><CheckBox x:Name="ShareResources" Content="CPU、内存与磁盘容量"/><CheckBox x:Name="ShareDisplay" Content="显示器与远程会话"/><CheckBox x:Name="ShareWhatPulse" Content="WhatPulse 计数与流量"/></StackPanel></WrapPanel><TextBlock Text="空闲阈值（分钟）" Margin="0,12,0,4"/><ui:NumberBox x:Name="IdleMinutes" Minimum="1" Maximum="60" Value="3"/><TextBlock Text="公开范围仍由服务端受众权限控制。新增类别不会自动公开。" Margin="0,16" Opacity="0.65"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="媒体"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="正在播放" FontSize="20"/><CheckBox x:Name="ShareMusic" Content="分享选中播放器的媒体"/><TextBlock Text="暂停或停止后立即撤回。先打开播放器，再刷新列表。" Opacity="0.65"/><ui:Button Content="刷新播放器" Click="RefreshPlayers" Margin="0,12"/><ListBox x:Name="PlayerList" Height="140"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" Content="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="优先播放器" Margin="0,12,0,6"/><ComboBox x:Name="PreferredPlayer"/><TextBlock Text="歌词目录" FontSize="20" Margin="0,24,0,8"/><TextBlock Text="从整个音乐目录读取内嵌歌词与同名 LRC，严格匹配当前歌曲。"/><TextBlock x:Name="DirectoryLabel" Margin="0,12" Opacity="0.65"/><WrapPanel><ui:Button Content="选择音乐目录" Click="ChooseDirectory" Margin="0,0,12,0"/><ui:Button Content="清除目录" Click="ClearDirectory" Margin="0,0,12,0"/><ui:Button Content="刷新歌词索引" Click="RefreshLyrics"/></WrapPanel><TextBlock x:Name="LyricsStatus" Margin="0,12"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="连接"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="状态服务" FontSize="20"/><TextBlock Text="HTTPS 地址" Margin="0,16,0,6"/><ui:TextBox x:Name="Endpoint" PlaceholderText="https://example.com/presence"/><TextBlock Text="此电脑的写入令牌" Margin="0,16,0,6"/><ui:PasswordBox x:Name="Token"/><TextBlock Text="令牌使用 Windows 当前用户保护，保存后可继续使用。" Margin="0,8" Opacity="0.65"/><CheckBox x:Name="AutoStart" Content="登录 Windows 时启动"/><TextBlock Text="WhatPulse 本地 API 端口" FontSize="18" Margin="0,20,0,8"/><ui:NumberBox x:Name="PulsePort" Minimum="1024" Maximum="65535" Value="3490"/><TextBlock Text="仅连接 127.0.0.1；读取计数，不触发 Pulse 或修改 Profile。" Margin="0,8" Opacity="0.65"/><TextBlock x:Name="PulseStatus" Margin="0,8"/><TextBlock Text="关闭窗口后继续驻留托盘。使用托盘“退出”可停止并清空分享。" Margin="0,24"/></StackPanel></ScrollViewer></TabItem>
</TabControl></Grid></DockPanel></ui:FluentWindow>