<ui:FluentWindow x:Class="StateOfMe.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="State of Me" Width="1040" Height="740" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" ExtendsContentIntoTitleBar="True">
<DockPanel><ui:TitleBar Title="State of Me" DockPanel.Dock="Top"/><Border DockPanel.Dock="Bottom" Padding="24,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"><TextBlock x:Name="StatusText" TextWrapping="Wrap"/></Border>
<ui:NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsPaneToggleVisible="False" IsBackButtonVisible="Collapsed" OpenPaneLength="170">
<ui:NavigationView.MenuItems><ui:NavigationViewItem x:Name="OverviewNav" Content="概览" Tag="Overview" Click="Navigate" Icon="{ui:SymbolIcon Home24}"/><ui:NavigationViewItem x:Name="CollectionNav" Content="采集" Tag="Collection" Click="Navigate" Icon="{ui:SymbolIcon Apps24}"/><ui:NavigationViewItem x:Name="SharingNav" Content="分享" Tag="Sharing" Click="Navigate" Icon="{ui:SymbolIcon Share24}"/><ui:NavigationViewItem x:Name="SettingsNav" Content="设置" Tag="Settings" Click="Navigate" Icon="{ui:SymbolIcon Settings24}"/></ui:NavigationView.MenuItems>
<ui:NavigationView.ContentOverlay><Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="PageTitle" Text="概览" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/><Grid Grid.Row="1"><ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" Visibility="Visible"><StackPanel Margin="0,0,12,20"><WrapPanel Margin="0,0,0,20"><ui:Button x:Name="StartButton" Content="开始同步" Click="StartSync" Appearance="Primary" Margin="0,0,12,0"/><ui:Button x:Name="PauseSyncButton" Content="暂停同步" Click="Pause" Margin="0,0,12,0"/><ui:Button x:Name="TimedPauseButton" Content="暂停 15 分钟" Click="HideBriefly"/></WrapPanel><TextBlock Text="同步使用已保存的采集设置。未保存的选择不会立即生效。" TextWrapping="Wrap" Margin="0,0,0,16" Opacity="0.65"/><ui:Card Padding="20"><StackPanel><TextBlock Text="当前状态" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="Summary" FontSize="16" Margin="0,12"/><TextBlock x:Name="MediaSummary" TextWrapping="Wrap" Margin="0,8"/></StackPanel></ui:Card><TextBlock x:Name="CollectionSummary" Margin="0,12,0,4"/><ui:Button Content="调整采集内容" Click="OpenCollection" HorizontalAlignment="Left" Margin="0,4,0,4"/><TextBlock Text="统计结果" FontSize="20" Margin="0,20,0,8"/><TextBlock x:Name="Statistics" TextWrapping="Wrap"/><TextBlock Text="临时状态" FontSize="18" Margin="0,24,0,8"/><ui:TextBox x:Name="Manual" PlaceholderText="例如：专注写代码，稍后回复" MaxLength="120"/><TextBlock Text="保存后保留 1 小时，留空即清除；暂停同步时不会上传。" Margin="0,8" Opacity="0.65"/><WrapPanel Margin="0,8"><ui:Button Content="保存临时状态" Click="SaveManual"/></WrapPanel><Expander Header="本地上传预览与诊断" Margin="0,16"><StackPanel><TextBlock x:Name="Counters" Opacity="0.65" Margin="0,8"/><TextBlock x:Name="Health" Margin="0,8"/><TextBox x:Name="Preview" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" MaxHeight="230"/></StackPanel></Expander></StackPanel></ScrollViewer><ScrollViewer x:Name="CollectionPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,12,20"><TextBlock Text="选择这台电脑采集并同步到自己账号的信息。对群和访客的权限在分享页管理。" TextWrapping="Wrap" Margin="0,0,0,16"/><Expander Header="应用" IsExpanded="True" Margin="0,0,0,20"><StackPanel Margin="4,12"><TextBlock Text="前台应用" FontSize="20"/><TextBlock Text="白名单：仅采集勾选应用，空列表不采集。黑名单：排除勾选应用，空列表采集所有前台应用。修改后保存采集设置。只采集当前前台窗口，不上传后台应用列表或窗口标题。" Margin="0,8"/><ComboBox x:Name="FilterMode" SelectedIndex="1"><ComboBoxItem Content="关闭应用采集"/><ComboBoxItem Content="只采集选中的应用"/><ComboBoxItem Content="排除选中的应用"/></ComboBox><DockPanel Margin="0,12"><ui:Button DockPanel.Dock="Right" Content="刷新应用" Click="RefreshApps" Margin="12,0,0,0"/><ui:TextBox x:Name="Search" PlaceholderText="搜索应用名称" TextChanged="SearchChanged"/></DockPanel><TextBlock x:Name="AppSearchHint" Opacity="0.7" Margin="0,0,0,8"/><ListBox x:Name="AppList" Height="220"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><DockPanel><ui:TextBox PlaceholderText="展示别名（可选）" DockPanel.Dock="Right" Text="{Binding Alias,UpdateSourceTrigger=PropertyChanged}" Width="160" Height="32" MaxLength="120" ToolTip="可选展示别名" Margin="12,0"/><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0"/><CheckBox Margin="0" IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Label}" ToolTip="{Binding Id}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Expander><Expander Header="媒体与歌词" IsExpanded="False" Margin="0,0,0,20"><StackPanel Margin="4,12"><TextBlock Text="播放器与歌词" FontSize="20"/><CheckBox x:Name="ShareMusic" Content="采集选中播放器的媒体"/><TextBlock Text="暂停或停止后立即撤回。先打开播放器，再刷新列表。" Opacity="0.65"/><ui:Button Content="刷新播放器" Click="RefreshPlayers" Margin="0,12"/><TextBlock x:Name="PlayerHint" Opacity="0.7" Margin="0,0,0,8"/><ListBox x:Name="PlayerList" Height="140"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" Content="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="优先播放器" Margin="0,12,0,6"/><ComboBox x:Name="PreferredPlayer" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBlock Text="歌词目录" FontSize="20" Margin="0,24,0,8"/><TextBlock Text="从整个音乐目录读取内嵌歌词与同名 LRC，严格匹配当前歌曲。"/><TextBlock x:Name="DirectoryLabel" Margin="0,12" Opacity="0.65"/><WrapPanel><ui:Button Content="选择音乐目录" Click="ChooseDirectory" Margin="0,0,12,0"/><ui:Button Content="清除目录" Click="ClearDirectory" Margin="0,0,12,0"/><ui:Button Content="刷新歌词索引" Click="RefreshLyrics"/></WrapPanel><TextBlock x:Name="LyricsStatus" Margin="0,12"/></StackPanel></Expander><Expander Header="设备与系统" IsExpanded="False" Margin="0,0,0,20"><StackPanel Margin="4,12"><TextBlock Text="设备与系统" FontSize="20" Margin="0,20,0,6"/><WrapPanel><StackPanel Width="260"><CheckBox x:Name="SharePresence" Content="活跃、空闲与锁屏"/><CheckBox x:Name="ShareDevice" Content="电量与电源状态"/><CheckBox x:Name="ShareNetwork" Content="连接类型与联网状态"/><CheckBox x:Name="ShareAudio" Content="音量与静音"/></StackPanel><StackPanel><CheckBox x:Name="ShareResources" Content="CPU、内存与磁盘容量"/><CheckBox x:Name="ShareDisplay" Content="显示器与远程会话"/></StackPanel></WrapPanel><TextBlock Text="空闲阈值（分钟）" Margin="0,12,0,4"/><ui:NumberBox x:Name="IdleMinutes" Minimum="1" Maximum="60" Value="3"/><TextBlock Text="公开范围仍由服务端受众权限控制。新增类别不会自动公开。" Margin="0,16" Opacity="0.65"/></StackPanel></Expander><Expander Header="WhatPulse" IsExpanded="False" Margin="0,0,0,20"><StackPanel Margin="4,12"><CheckBox x:Name="ShareWhatPulse" Content="采集 WhatPulse 计数与流量"/><TextBlock Text="本地 API 端口" Margin="0,12,0,6"/><ui:NumberBox x:Name="PulsePort" Minimum="1024" Maximum="65535" Value="3490"/><TextBlock Text="仅连接 127.0.0.1；读取计数，不触发 Pulse 或修改 Profile。" TextWrapping="Wrap" Margin="0,8" Opacity="0.65"/><TextBlock x:Name="PulseStatus" Margin="0,8" TextWrapping="Wrap"/></StackPanel></Expander><ui:Button Content="保存采集设置" Click="SaveCollection" Appearance="Primary"/><TextBlock x:Name="CollectionNotice" Margin="0,12" TextWrapping="Wrap"/></StackPanel></ScrollViewer><ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,12,20"><ContentControl x:Name="AccountHost"/><Separator Margin="0,20"/><TextBlock Text="本机连接" FontSize="20"/><TextBlock x:Name="AccountLabel" TextWrapping="Wrap" Margin="0,8"/><ui:Button x:Name="DisconnectButton" Content="断开此设备" Click="DisconnectAccount"/><TextBlock x:Name="ConnectionNotice" TextWrapping="Wrap" Margin="0,8"/><Separator Margin="0,20"/><TextBlock Text="启动与后台" FontSize="20"/><CheckBox x:Name="AutoStart" Content="登录 Windows 时启动" Margin="0,12"/><ui:Button Content="保存启动设置" Click="SaveStartup"/><TextBlock x:Name="StartupNotice" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="关闭窗口后继续驻留托盘。使用托盘“退出”可停止同步。" TextWrapping="Wrap" Margin="0,12" Opacity="0.65"/></StackPanel></ScrollViewer><ContentControl x:Name="SharingPage" Visibility="Collapsed"/></Grid></Grid></ui:NavigationView.ContentOverlay></ui:NavigationView></DockPanel></ui:FluentWindow>